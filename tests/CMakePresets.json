{
  "version": 6,
  "configurePresets": [
    {
      "name": "host-tests",
      "displayName": "Host tests (g++/clang++, without ARM toolchain)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "host-tests", "configurePreset": "host-tests" }
  ],
  "testPresets": [
    {
      "name": "host-tests",
      "configurePreset": "host-tests",
      "output": { "outputOnFailure": true }
    }
  ]
}
